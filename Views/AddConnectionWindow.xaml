<Window x:Class="SocketTestTool.Views.AddConnectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SocketTestTool.Views"
        xmlns:common="clr-namespace:SocketTestTool.Common"
        mc:Ignorable="d"
        Title="연결 추가 Add Connection"
        Width="580" SizeToContent="Height" MaxHeight="860"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="{StaticResource UiFontFamily}"
        TextOptions.TextFormattingMode="Ideal">

    <Window.Resources>
        <common:StringToVisibilityConverter x:Key="StringToVis"/>

        <!-- 각 설정 묶음의 제목 -->
        <Style x:Key="GroupLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>

        <!-- 설정 묶음을 감싸는 흰 카드 -->
        <Style x:Key="SectionCardStyle" TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </Window.Resources>

    <DockPanel>

        <!-- 하단 확정 버튼 줄 -->
        <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardBorderBrush}"
                Background="{DynamicResource SubtleBackgroundBrush}" Padding="16,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" IsCancel="True" Width="96" Height="32"
                        Style="{StaticResource SecondaryButtonStyle}"/>
                <Button x:Name="OkButton" Content="추가 Add" IsDefault="True" Width="120" Height="32" Margin="8,0,0,0"
                        Style="{StaticResource AccentButtonStyle}" Click="OkButton_Click"/>
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,16,16,6">
            <StackPanel>

                <!-- 서버 / 클라이언트 -->
                <Border Style="{StaticResource SegmentTrackStyle}" HorizontalAlignment="Left" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="ServerModeRadio" Content="서버 Server" GroupName="ConnMode"
                                     Style="{StaticResource SegmentToggleStyle}" Padding="18,6"
                                     Checked="ConnectionMode_Changed"/>
                        <RadioButton x:Name="ClientModeRadio" Content="클라이언트 Client" GroupName="ConnMode"
                                     Style="{StaticResource SegmentToggleStyle}" Padding="18,6"
                                     Checked="ConnectionMode_Changed"/>
                    </StackPanel>
                </Border>

                <!-- 주소 -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="IP Address" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,5"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Port" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,5"/>

                            <TextBox Grid.Row="1" Grid.Column="0" x:Name="IpTextBox" Text="127.0.0.1"
                                     Style="{StaticResource FluentTextBoxStyle}" FontFamily="{StaticResource MonoFontFamily}"/>
                            <TextBox Grid.Row="1" Grid.Column="2" x:Name="PortTextBox" Text="8080"
                                     Style="{StaticResource FluentTextBoxStyle}" FontFamily="{StaticResource MonoFontFamily}"/>

                            <StackPanel Grid.Row="1" Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="TrafficLight" Width="12" Height="12" Fill="{DynamicResource StoppedDotBrush}"
                                         VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Button Content="Check" Height="30" Padding="14,0"
                                        Style="{StaticResource SecondaryButtonStyle}" Click="CheckConnection_Click"/>
                            </StackPanel>
                        </Grid>

                        <!-- Check 결과 인라인 표시 -->
                        <Border x:Name="CheckResultPanel" Margin="0,10,0,0" Padding="10,8"
                                CornerRadius="{StaticResource RadiusMedium}"
                                Background="{DynamicResource ControlFillBrush}"
                                Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="CheckResultIcon" Text="&#10003;" FontWeight="Bold" FontSize="12"
                                           VerticalAlignment="Center" Margin="0,0,8,0"
                                           Foreground="{DynamicResource SuccessBrush}"/>
                                <TextBlock x:Name="StatusText" Text="Ready to check connection."
                                           TextWrapping="Wrap" VerticalAlignment="Center"
                                           Style="{StaticResource BodyTextStyle}" FontSize="12"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 서버 전용 설정 -->
                <StackPanel x:Name="ServerOptionsPanel" Visibility="Collapsed">

                    <!-- 응답 패턴 -->
                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <TextBlock Text="응답 패턴 Response Pattern" Style="{StaticResource GroupLabelStyle}"/>
                            <UniformGrid Rows="2" Columns="2">
                                <RadioButton x:Name="EchoRadio" GroupName="Pattern" Tag="Echo" Margin="0,0,5,5"
                                             Style="{StaticResource RadioCardStyle}" IsChecked="True"
                                             Checked="ResponsePattern_Changed">
                                    <StackPanel>
                                        <TextBlock Text="수신 데이터 그대로 응답" FontWeight="SemiBold" FontSize="12"/>
                                        <TextBlock Text="Echo" Style="{StaticResource CaptionTextStyle}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="ReplyAfterReceiveRadio" GroupName="Pattern" Tag="ReplyAfterReceive" Margin="5,0,0,5"
                                             Style="{StaticResource RadioCardStyle}" Checked="ResponsePattern_Changed">
                                    <StackPanel>
                                        <TextBlock Text="수신 후 응답" FontWeight="SemiBold" FontSize="12"/>
                                        <TextBlock Text="Reply After Receive" Style="{StaticResource CaptionTextStyle}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="SendOnceRadio" GroupName="Pattern" Tag="SendOnce" Margin="0,5,5,0"
                                             Style="{StaticResource RadioCardStyle}" Checked="ResponsePattern_Changed">
                                    <StackPanel>
                                        <TextBlock Text="1회만 OK 응답" FontWeight="SemiBold" FontSize="12"/>
                                        <TextBlock Text="Send Once on Connect" Style="{StaticResource CaptionTextStyle}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="ListenOnlyRadio" GroupName="Pattern" Tag="ListenOnly" Margin="5,5,0,0"
                                             Style="{StaticResource RadioCardStyle}" Checked="ResponsePattern_Changed">
                                    <StackPanel>
                                        <TextBlock Text="수동 응답" FontWeight="SemiBold" FontSize="12"/>
                                        <TextBlock Text="Listen Only" Style="{StaticResource CaptionTextStyle}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </RadioButton>
                            </UniformGrid>

                            <!-- 수신 후 응답 전용 옵션 -->
                            <StackPanel x:Name="ReplyOptionsPanel" Visibility="Collapsed" Margin="0,12,0,0">
                                <TextBlock Text="응답 데이터 Reply Data" Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,5"/>
                                <TextBox x:Name="ReplyMessageTextBox"
                                         Style="{StaticResource FluentTextBoxStyle}" FontFamily="{StaticResource MonoFontFamily}"/>

                                <Grid Margin="0,10,0,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="수신 대기 Receive timeout" VerticalAlignment="Center"
                                                   Style="{StaticResource CaptionTextStyle}"/>
                                        <TextBox x:Name="ReceiveTimeoutTextBox" Text="300" Width="64" Margin="10,0,0,0"
                                                 Style="{StaticResource FluentTextBoxStyle}" FontFamily="{StaticResource MonoFontFamily}"
                                                 ToolTip="데이터가 끊겨서 들어올 때, 합쳐서 받기 위해 대기하는 시간"/>
                                        <TextBlock Text="ms · 조각화 방지" VerticalAlignment="Center" Margin="8,0,0,0"
                                                   Style="{StaticResource CaptionTextStyle}"/>
                                    </StackPanel>
                                    <CheckBox x:Name="EndlessReplyCheckBox" Content="지속 응답" HorizontalAlignment="Right"
                                              VerticalAlignment="Center" Style="{StaticResource FluentCheckBoxStyle}"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 규칙 기반 응답 -->
                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,7">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="규칙 기반 응답 Rule-based" Style="{StaticResource GroupLabelStyle}" Margin="0"/>
                                    <TextBlock x:Name="RuleCountText" Text="0 rules" Margin="8,0,0,0" VerticalAlignment="Center"
                                               Style="{StaticResource CaptionTextStyle}"/>
                                </StackPanel>
                            </Grid>

                            <!-- 표 머리글 -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="34"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="IF RECEIVE CONTAINS" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Grid.Column="2" Text="THEN SEND" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                            </Grid>

                            <ItemsControl x:Name="RulesItemsControl" MaxHeight="130">
                                <ItemsControl.Template>
                                    <ControlTemplate TargetType="ItemsControl">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer>
                                    </ControlTemplate>
                                </ItemsControl.Template>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="34"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="{DynamicResource ControlFillBrush}"
                                                    CornerRadius="{StaticResource RadiusSmall}" Padding="8,5">
                                                <TextBlock Text="{Binding ReceiveData}" FontFamily="{StaticResource MonoFontFamily}"
                                                           FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                                            </Border>
                                            <Border Grid.Column="2" Background="{DynamicResource ControlFillBrush}"
                                                    CornerRadius="{StaticResource RadiusSmall}" Padding="8,5">
                                                <TextBlock Text="{Binding SendData}" FontFamily="{StaticResource MonoFontFamily}"
                                                           FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                                            </Border>
                                            <Button Grid.Column="3" Content="&#10005;" Style="{StaticResource IconButtonStyle}"
                                                    HorizontalAlignment="Center" Click="RemoveRule_Click" Tag="{Binding}"
                                                    ToolTip="이 규칙을 삭제합니다."/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 규칙 추가 줄 -->
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="ReceiveRuleTextBox" Height="28"
                                         Style="{StaticResource FluentTextBoxStyle}" FontFamily="{StaticResource MonoFontFamily}"
                                         ToolTip="If Receive Contains..."/>
                                <TextBox Grid.Column="2" x:Name="SendRuleTextBox" Height="28"
                                         Style="{StaticResource FluentTextBoxStyle}" FontFamily="{StaticResource MonoFontFamily}"
                                         ToolTip="Then Send..."/>
                                <Button Grid.Column="3" Content="+ Add" Height="28" Padding="10,0" Margin="6,0,0,0"
                                        Style="{StaticResource SecondaryButtonStyle}" Click="AddRule_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 수신 데이터 자동 전달 -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <CheckBox x:Name="ForwardingCheckBox" Content="수신 데이터 자동 전달 Forwarding"
                                  Style="{StaticResource ToggleSwitchStyle}" FontWeight="SemiBold"
                                  ToolTip="이 연결에서 받은 원본 바이트를 아래 서버로 그대로 중계합니다."/>

                        <Grid x:Name="ForwardTargetPanel" Margin="0,12,0,0">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=ForwardingCheckBox}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="86"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="대상 IP" VerticalAlignment="Center"
                                       Style="{StaticResource CaptionTextStyle}" Margin="0,0,10,0"/>
                            <TextBox Grid.Column="1" x:Name="ForwardIpTextBox" Text="127.0.0.1" Height="28"
                                     Style="{StaticResource FluentTextBoxStyle}" FontFamily="{StaticResource MonoFontFamily}"/>
                            <TextBlock Grid.Column="2" Text="Port" VerticalAlignment="Center"
                                       Style="{StaticResource CaptionTextStyle}" Margin="12,0,10,0"/>
                            <TextBox Grid.Column="3" x:Name="ForwardPortTextBox" Text="9090" Height="28"
                                     Style="{StaticResource FluentTextBoxStyle}" FontFamily="{StaticResource MonoFontFamily}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 로그 저장 -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <CheckBox x:Name="LogOnRadio" Content="로그 자동저장 Log auto-save" IsChecked="True"
                                  Style="{StaticResource ToggleSwitchStyle}" FontWeight="SemiBold"/>

                        <Grid x:Name="LogPathPanel" Margin="0,12,0,0">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=LogOnRadio}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="LogFilePathTextBox" Height="28"
                                     Style="{StaticResource FluentTextBoxStyle}" FontSize="11.5"
                                     ToolTip="Log file path"/>
                            <Button Grid.Column="1" Content="…" Height="28" Width="34" Margin="6,0,0,0"
                                    Style="{StaticResource SecondaryButtonStyle}" Click="BrowseLogFile_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
