<Window x:Class="SocketTestTool.Views.VersionHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SocketTestTool.Views"
        xmlns:common="clr-namespace:SocketTestTool.Common"
        mc:Ignorable="d"
        Title="버전 기록 Version History" Height="700" Width="960" MinHeight="480" MinWidth="720"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="{StaticResource UiFontFamily}"
        TextOptions.TextFormattingMode="Ideal">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- 릴리스 노트 한 줄: 제목 + 설명 -->
        <DataTemplate x:Key="NoteItemTemplate">
            <StackPanel Margin="0,0,0,11">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12.5"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,3,0,0"
                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
        </DataTemplate>

        <!-- 좌측 버전 목록 항목 -->
        <Style x:Key="VersionItemContainerStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="{StaticResource RadiusMedium}" Padding="12,10">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverOverlayBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
                                <Setter TargetName="Bd" Property="Effect" Value="{DynamicResource CardShadow}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 좌측: 버전 타임라인 -->
        <DockPanel Grid.Column="0">
            <TextBlock DockPanel.Dock="Top" Text="릴리스 Releases" Margin="12,0,0,10"
                       Style="{StaticResource SectionTitleTextStyle}"/>
            <ListBox x:Name="VersionListBox"
                     ItemContainerStyle="{StaticResource VersionItemContainerStyle}"
                     Background="Transparent" BorderThickness="0"
                     SelectionChanged="VersionListBox_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Version}" FontWeight="SemiBold" FontSize="13"
                                           FontFamily="{StaticResource MonoFontFamily}"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <Border Margin="8,0,0,0" Padding="5,1" VerticalAlignment="Center"
                                        CornerRadius="{StaticResource RadiusSmall}"
                                        Background="{DynamicResource AccentBadgeBrush}"
                                        Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="CURRENT" FontSize="9" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentBrush}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding ListSubtitle}" Margin="0,4,0,0"
                                       Style="{StaticResource CaptionTextStyle}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- 우측: 선택한 버전의 상세 -->
        <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" ClipToBounds="True">
            <DockPanel>

                <!-- 머리글 + 요약 수치 -->
                <Border DockPanel.Dock="Top" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource CardBorderBrush}"
                        Padding="20,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Version}" FontSize="20" FontWeight="SemiBold"
                                       FontFamily="{StaticResource MonoFontFamily}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <Border Margin="10,0,0,0" Padding="6,2" VerticalAlignment="Center"
                                    CornerRadius="{StaticResource RadiusSmall}"
                                    Background="{DynamicResource AccentBadgeBrush}"
                                    Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="CURRENT" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentBrush}"/>
                            </Border>
                            <TextBlock Text="{Binding ReleaseDate}" Margin="12,0,0,0" VerticalAlignment="Center"
                                       Style="{StaticResource CaptionTextStyle}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,26,0">
                                <TextBlock Text="{Binding FeatureCount}" FontSize="20" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="주요 기능" FontSize="11.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Features" Style="{StaticResource CaptionTextStyle}" FontSize="10.5"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,26,0">
                                <TextBlock Text="{Binding ImprovementCount}" FontSize="20" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center"/>
                                <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="개선 사항" FontSize="11.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Improvements" Style="{StaticResource CaptionTextStyle}" FontSize="10.5"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding BugFixCount}" FontSize="20" FontWeight="SemiBold"
                                           Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center"/>
                                <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="버그 수정" FontSize="11.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Bug Fixes" Style="{StaticResource CaptionTextStyle}" FontSize="10.5"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 본문 -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16">
                    <StackPanel>
                        <StackPanel Visibility="{Binding HasFeatures, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="주요 기능 Features" Margin="0,0,0,10"
                                       Style="{StaticResource SectionTitleTextStyle}"
                                       Foreground="{DynamicResource AccentBrush}"/>
                            <ItemsControl ItemsSource="{Binding Features}" ItemTemplate="{StaticResource NoteItemTemplate}"/>
                        </StackPanel>

                        <StackPanel Margin="0,10,0,0" Visibility="{Binding HasImprovements, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="개선 사항 Improvements" Margin="0,0,0,10"
                                       Style="{StaticResource SectionTitleTextStyle}"
                                       Foreground="{DynamicResource SuccessBrush}"/>
                            <ItemsControl ItemsSource="{Binding Improvements}" ItemTemplate="{StaticResource NoteItemTemplate}"/>
                        </StackPanel>

                        <StackPanel Margin="0,10,0,0" Visibility="{Binding HasBugFixes, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="버그 수정 Bug Fixes" Margin="0,0,0,10"
                                       Style="{StaticResource SectionTitleTextStyle}"
                                       Foreground="{DynamicResource WarningBrush}"/>
                            <ItemsControl ItemsSource="{Binding BugFixes}" ItemTemplate="{StaticResource NoteItemTemplate}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>
