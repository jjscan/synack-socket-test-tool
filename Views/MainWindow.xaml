<Window x:Class="SocketTestTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SocketTestTool"
        xmlns:viewmodels="clr-namespace:SocketTestTool.ViewModels"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:common="clr-namespace:SocketTestTool.Common"
        mc:Ignorable="d"
        Title="SYN/ACK - Socket Test Tool" Height="650" Width="1200" MinHeight="520" MinWidth="900"
        Background="{DynamicResource WindowBackgroundBrush}"
        TextOptions.TextFormattingMode="Ideal"
        FontFamily="{StaticResource UiFontFamily}">

    <Window.DataContext>
        <viewmodels:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <common:BytesToHexConverter x:Key="BytesToHexConverter"/>
        <common:LogDirectionToBadgeConverter x:Key="DirBadge"/>
        <common:LogDirectionToBrushConverter x:Key="DirBrush"/>
        <common:ConnectionTypeToBadgeConverter x:Key="TypeBadge"/>
        <common:StatusToPillConverter x:Key="StatusPill"/>
        <common:StatusToOpacityConverter x:Key="StatusOpacity"/>
        <common:ByteCountToHumanConverter x:Key="Bytes"/>
        <common:StringToVisibilityConverter x:Key="StringToVis"/>
        <common:EmptyCountToVisibilityConverter x:Key="EmptyToVis"/>
        <common:BannerSeverityToBrushConverter x:Key="BannerBrush"/>
        <common:PathToFileNameConverter x:Key="FileName"/>

        <!-- 연결 목록 항목: 기본 선택 하이라이트를 없애고 카드가 스스로 상태를 표현하게 합니다. -->
        <Style x:Key="ConnectionItemContainerStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 로그 행: 방향별 배경 틴트가 행 전체 폭을 덮도록 합니다. -->
        <Style x:Key="LogItemContainerStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>

        <!-- ==================== 메뉴 ==================== -->
        <Menu DockPanel.Dock="Top" Style="{StaticResource FluentMenuStyle}">
            <MenuItem Header="파일 _File">
                <MenuItem Header="_Save Session" Command="{Binding SaveSessionCommand}"/>
                <MenuItem Header="_Load Session" Command="{Binding LoadSessionCommand}"/>
                <MenuItem Header="Save _Log" Command="{Binding SaveLogCommand}"/>
                <Separator/>
                <MenuItem Header="_Exit" Command="{Binding ExitCommand}"/>
            </MenuItem>
            <MenuItem Header="보기 _View">
                <MenuItem Header="테마 Theme">
                    <MenuItem Header="시스템 설정 따르기 System" IsCheckable="True"
                              IsChecked="{Binding IsSystemTheme, Mode=OneWay}"
                              Command="{Binding SetThemeCommand}" CommandParameter="System"/>
                    <MenuItem Header="라이트 Light" IsCheckable="True"
                              IsChecked="{Binding IsLightTheme, Mode=OneWay}"
                              Command="{Binding SetThemeCommand}" CommandParameter="Light"/>
                    <MenuItem Header="다크 Dark" IsCheckable="True"
                              IsChecked="{Binding IsDarkTheme, Mode=OneWay}"
                              Command="{Binding SetThemeCommand}" CommandParameter="Dark"/>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="도움말 _Help">
                <MenuItem Header="_Version History" Command="{Binding ShowVersionHistoryCommand}"/>
            </MenuItem>
        </Menu>

        <!-- ==================== 상태 표시줄 ==================== -->
        <Border DockPanel.Dock="Bottom" Height="28" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource CardBorderBrush}">
            <Grid Margin="16,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="6" Height="6" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding StatusText}" Margin="6,0,0,0"
                               Style="{StaticResource CaptionTextStyle}" FontSize="11.5" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ConnectionStatsText}" Margin="14,0,0,0"
                               Style="{StaticResource CaptionTextStyle}" FontSize="11.5" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="{Binding AppVersionText}" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Style="{StaticResource CaptionTextStyle}" FontSize="11.5"/>
            </Grid>
        </Border>

        <!-- ==================== 본문 ==================== -->
        <Grid>
            <Grid Margin="12,0,12,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ========== 인라인 알림 배너 (목업 1f) ========== -->
                <ItemsControl Grid.Row="0" ItemsSource="{Binding Banners}" Margin="0,0,0,10">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,8" CornerRadius="{StaticResource RadiusCard}"
                                    Background="{Binding Severity, Converter={StaticResource BannerBrush}, ConverterParameter=Background}"
                                    BorderBrush="{Binding Severity, Converter={StaticResource BannerBrush}, ConverterParameter=Border}"
                                    BorderThickness="1" Padding="12,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 심각도 아이콘 -->
                                    <Border Grid.Column="0" Width="20" Height="20" CornerRadius="10" VerticalAlignment="Top"
                                            Background="{Binding Severity, Converter={StaticResource BannerBrush}, ConverterParameter=Foreground}">
                                        <TextBlock Text="!" Foreground="White" FontWeight="Bold" FontSize="12"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="10,0,10,0">
                                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="12.5"
                                                   Foreground="{Binding Severity, Converter={StaticResource BannerBrush}, ConverterParameter=Foreground}"/>
                                        <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Margin="0,3,0,0"
                                                   Style="{StaticResource CaptionTextStyle}"
                                                   Visibility="{Binding Detail, Converter={StaticResource StringToVis}}"/>
                                        <TextBlock Text="{Binding TechnicalDetail}" Margin="0,3,0,0"
                                                   FontFamily="{StaticResource MonoFontFamily}" FontSize="10.5"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   Visibility="{Binding TechnicalDetail, Converter={StaticResource StringToVis}}"/>

                                        <!-- 동작 버튼들 -->
                                        <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                            <Button Content="{Binding PrimaryActionText}" Command="{Binding PrimaryActionCommand}"
                                                    Style="{StaticResource SecondaryButtonStyle}" Height="27" Margin="0,0,6,0"
                                                    Visibility="{Binding PrimaryActionText, Converter={StaticResource StringToVis}}"/>
                                            <Button Content="{Binding SecondaryActionText}" Command="{Binding SecondaryActionCommand}"
                                                    Style="{StaticResource SecondaryButtonStyle}" Height="27" Margin="0,0,6,0"
                                                    Visibility="{Binding SecondaryActionText, Converter={StaticResource StringToVis}}"/>
                                            <Button Content="{Binding TertiaryActionText}" Command="{Binding TertiaryActionCommand}"
                                                    Style="{StaticResource SubtleButtonStyle}" Height="27"
                                                    Visibility="{Binding TertiaryActionText, Converter={StaticResource StringToVis}}"/>
                                        </StackPanel>

                                        <TextBlock Text="{Binding StatusNote}" Margin="0,7,0,0" TextWrapping="Wrap"
                                                   FontFamily="{StaticResource MonoFontFamily}" FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Visibility="{Binding StatusNote, Converter={StaticResource StringToVis}}"/>
                                    </StackPanel>

                                    <Button Grid.Column="2" Content="&#10005;" VerticalAlignment="Top"
                                            Style="{StaticResource IconButtonStyle}"
                                            Command="{Binding DismissCommand}" CommandParameter="{Binding}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- ========== 두 분할 본문 ========== -->
                <Grid Grid.Row="1"
                      Visibility="{Binding Connections.Count, Converter={StaticResource EmptyToVis}, ConverterParameter=Invert}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="344"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ========== 좌측: 연결 목록 ========== -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 헤더 -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="연결 Connections" Style="{StaticResource SectionTitleTextStyle}"/>
                                <TextBlock Text="{Binding Connections.Count}" Margin="8,0,0,0" VerticalAlignment="Center"
                                           Style="{StaticResource BodyTextStyle}" Foreground="{DynamicResource TextTertiaryBrush}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="+ Server" Command="{Binding AddServerCommand}"
                                        Style="{StaticResource AccentButtonStyle}" Height="28" Padding="11,0"/>
                                <Button Content="+ Client" Command="{Binding AddClientCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}" Height="28" Padding="11,0" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- 연결 카드 목록 -->
                        <ListView Grid.Row="1" x:Name="ConnectionListView"
                                  ItemsSource="{Binding Connections}"
                                  SelectedItem="{Binding SelectedConnection}"
                                  ItemContainerStyle="{StaticResource ConnectionItemContainerStyle}"
                                  SelectionMode="Extended"
                                  Background="Transparent" BorderThickness="0"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  SelectionChanged="ConnectionListView_SelectionChanged">
                            <i:Interaction.Behaviors>
                                <common:SelectedItemsBehavior SelectedItems="{Binding SelectedItems}"/>
                            </i:Interaction.Behaviors>

                            <ListView.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" Opened="ContextMenu_Opened">
                                    <MenuItem Header="Start" Command="{Binding StartConnectionCommand}"/>
                                    <MenuItem Header="Stop" Command="{Binding StopConnectionCommand}"/>
                                    <Separator/>
                                    <MenuItem Header="Edit" Command="{Binding EditCommand}"/>
                                    <MenuItem Header="Remove" Command="{Binding RemoveCommand}"/>
                                </ContextMenu>
                            </ListView.ContextMenu>

                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Card" Background="{DynamicResource CardBackgroundBrush}"
                                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                            CornerRadius="{StaticResource RadiusCard}" Padding="12,11"
                                            Opacity="{Binding Status, Converter={StaticResource StatusOpacity}}"
                                            Effect="{DynamicResource CardShadow}">
                                        <StackPanel>
                                            <!-- 1행: 타입 배지 · 주소 · 상태 필 -->
                                            <Grid>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border CornerRadius="{StaticResource RadiusSmall}" Padding="6,3"
                                                            Background="{Binding Type, Converter={StaticResource TypeBadge}, ConverterParameter=Background}">
                                                        <TextBlock Text="{Binding Type, Converter={StaticResource TypeBadge}, ConverterParameter=Text}"
                                                                   Style="{StaticResource BadgeTextStyle}"
                                                                   Foreground="{Binding Type, Converter={StaticResource TypeBadge}, ConverterParameter=Foreground}"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Address}" Margin="8,0,0,0" VerticalAlignment="Center"
                                                               FontFamily="{StaticResource MonoFontFamily}" FontSize="13" FontWeight="Medium"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                                             Fill="{Binding Status, Converter={StaticResource StatusPill}, ConverterParameter=Dot}"/>
                                                    <TextBlock Text="{Binding Status, Converter={StaticResource StatusPill}, ConverterParameter=Text}"
                                                               Margin="5,0,0,0" VerticalAlignment="Center"
                                                               FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{Binding Status, Converter={StaticResource StatusPill}, ConverterParameter=Foreground}"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- 2행: 요약 · 송수신량 -->
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                                        Visibility="{Binding MetaText, Converter={StaticResource StringToVis}}">
                                                <TextBlock Text="{Binding MetaText}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center"/>
                                                <TextBlock Margin="10,0,0,0" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource AccentBrush}">
                                                    <Run Text="▲"/><Run Text=" "/><Run Text="{Binding BytesSent, Converter={StaticResource Bytes}, Mode=OneWay}"/>
                                                </TextBlock>
                                                <TextBlock Margin="8,0,0,0" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource SuccessBrush}">
                                                    <Run Text="▼"/><Run Text=" "/><Run Text="{Binding BytesReceived, Converter={StaticResource Bytes}, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>

                                            <!-- 오류 한 줄 -->
                                            <TextBlock Text="{Binding ErrorText}" Margin="0,7,0,0" TextWrapping="Wrap"
                                                       FontSize="11" Foreground="{DynamicResource DangerBrush}"
                                                       Visibility="{Binding ErrorText, Converter={StaticResource StringToVis}}"/>
                                        </StackPanel>
                                    </Border>

                                    <DataTemplate.Triggers>
                                        <!-- 선택된 카드는 강조색 테두리로 표시합니다. -->
                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListViewItem}}" Value="True">
                                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            <Setter TargetName="Card" Property="BorderThickness" Value="1.5"/>
                                            <Setter TargetName="Card" Property="Effect" Value="{DynamicResource SelectedCardShadow}"/>
                                        </DataTrigger>
                                        <!-- 오류 상태 카드는 붉은 테두리 -->
                                        <DataTrigger Binding="{Binding Status}" Value="Error">
                                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- 목록 하단 동작 버튼 -->
                        <UniformGrid Grid.Row="2" Rows="1" Columns="4" Margin="0,10,0,0">
                            <Button Content="▶ Start" Command="{Binding StartConnectionCommand}"
                                    Style="{StaticResource SuccessTextButtonStyle}" Margin="0,0,3,0"/>
                            <Button Content="■ Stop" Command="{Binding StopConnectionCommand}"
                                    Style="{StaticResource DangerTextButtonStyle}" Margin="3,0"/>
                            <Button Content="Edit" Command="{Binding EditCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" Margin="3,0"/>
                            <Button Content="Remove" Command="{Binding RemoveCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" Margin="3,0,0,0"/>
                        </UniformGrid>
                    </Grid>

                    <!-- ========== 우측: 로그 + 컴포저 ========== -->
                    <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- ===== 도구 줄 ===== -->
                            <Border Grid.Row="0" Height="46" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource CardBorderBrush}">
                                <Grid Margin="12,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- 검색 + 일치/전체 -->
                                        <Grid Width="240">
                                            <TextBox x:Name="SearchTextBox"
                                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource FluentTextBoxStyle}"
                                                     Padding="26,0,44,0"
                                                     TextChanged="SearchTextBox_TextChanged"
                                                     ToolTip="로그 본문과 Hex를 함께 검색합니다."/>
                                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="9,0,0,0"
                                                       VerticalAlignment="Center" HorizontalAlignment="Left"
                                                       Foreground="{DynamicResource TextMutedBrush}" IsHitTestVisible="False"/>
                                            <TextBlock Text="{Binding LogCountText}" FontSize="11" Margin="0,0,9,0"
                                                       VerticalAlignment="Center" HorizontalAlignment="Right"
                                                       Foreground="{DynamicResource TextMutedBrush}" IsHitTestVisible="False"/>
                                        </Grid>

                                        <!-- Text / 기호 / Hex 세그먼트 -->
                                        <Border Style="{StaticResource SegmentTrackStyle}" Margin="10,0,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton Content="Text" GroupName="LogView" Style="{StaticResource SegmentToggleStyle}"
                                                             IsChecked="{Binding IsTextView}"/>
                                                <RadioButton Content="기호" GroupName="LogView" Style="{StaticResource SegmentToggleStyle}"
                                                             IsChecked="{Binding IsSymbolView}"/>
                                                <RadioButton Content="Hex" GroupName="LogView" Style="{StaticResource SegmentToggleStyle}"
                                                             IsChecked="{Binding IsHexView}"/>
                                            </StackPanel>
                                        </Border>

                                        <CheckBox Content="자동 스크롤" Margin="12,0,0,0"
                                                  Style="{StaticResource ToggleSwitchStyle}"
                                                  IsChecked="{Binding IsAutoScrollEnabled}"/>
                                    </StackPanel>

                                    <!-- 우측 통계 -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center">
                                            <Run Text="▲"/><Run Text=" "/><Run Text="{Binding SelectedConnection.BytesSent, Converter={StaticResource Bytes}, Mode=OneWay, FallbackValue='0 B'}"/>
                                        </TextBlock>
                                        <TextBlock Margin="12,0,0,0" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center">
                                            <Run Text="▼"/><Run Text=" "/><Run Text="{Binding SelectedConnection.BytesReceived, Converter={StaticResource Bytes}, Mode=OneWay, FallbackValue='0 B'}"/>
                                        </TextBlock>
                                        <TextBlock Margin="12,0,0,0" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center">
                                            <Run Text="{Binding SelectedConnection.MessageCount, Mode=OneWay, FallbackValue=0}"/><Run Text=" msgs"/>
                                        </TextBlock>
                                        <TextBlock Margin="12,0,0,0" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center">
                                            <Run Text="{Binding SelectedConnection.MessagesPerSecond, Mode=OneWay, StringFormat={}{0:0.0}, FallbackValue=0.0}"/><Run Text=" msg/s"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- ===== 로그 테이블 ===== -->
                            <ListView Grid.Row="1" x:Name="LogListView"
                                      ItemsSource="{Binding SelectedConnection.Logs}"
                                      ItemContainerStyle="{StaticResource LogItemContainerStyle}"
                                      Background="Transparent" BorderThickness="0"
                                      Padding="0,6"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding Direction, Converter={StaticResource DirBrush}, ConverterParameter=RowTint}"
                                                Padding="12,6">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="88"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="{Binding TimeText}" VerticalAlignment="Top"
                                                               FontFamily="{StaticResource MonoFontFamily}" FontSize="11.5"
                                                               Foreground="{DynamicResource TextFaintBrush}"/>

                                                    <Border Grid.Column="1" Margin="10,0" Padding="6,1" VerticalAlignment="Top"
                                                            CornerRadius="3"
                                                            Background="{Binding Direction, Converter={StaticResource DirBrush}, ConverterParameter=Badge}">
                                                        <TextBlock Text="{Binding Direction, Converter={StaticResource DirBadge}}"
                                                                   FontSize="10" FontWeight="SemiBold"
                                                                   Foreground="{Binding Direction, Converter={StaticResource DirBrush}}"/>
                                                    </Border>

                                                    <!-- 본문: 보기 모드에 따라 하나만 표시됩니다. -->
                                                    <Grid Grid.Column="2">
                                                        <TextBlock x:Name="TextPayload" Text="{Binding PayloadText}" TextWrapping="Wrap"
                                                                   FontFamily="{StaticResource MonoFontFamily}" FontSize="12.5"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   Visibility="Visible"/>
                                                        <TextBlock x:Name="SymbolPayload" Text="{Binding RenderedPayloadText}" TextWrapping="Wrap"
                                                                   FontFamily="{StaticResource MonoFontFamily}" FontSize="12.5"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   Visibility="Collapsed"/>
                                                    </Grid>

                                                    <TextBlock Grid.Column="3" Text="{Binding ByteCountText}" Margin="10,0,0,0" VerticalAlignment="Top"
                                                               FontFamily="{StaticResource MonoFontFamily}" FontSize="11"
                                                               Foreground="{DynamicResource TextFaintBrush}"/>
                                                </Grid>

                                                <!-- Hex 보기일 때만 아래에 16진수 덤프를 덧붙입니다. -->
                                                <TextBlock x:Name="HexLine" Text="{Binding HexText}" Margin="98,3,0,2" TextWrapping="Wrap"
                                                           FontFamily="{StaticResource MonoFontFamily}" FontSize="11"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           Visibility="Collapsed"/>
                                            </StackPanel>
                                        </Border>

                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.IsSymbolView, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                <Setter TargetName="TextPayload" Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="SymbolPayload" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding DataContext.IsHexView, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                                                    <Condition Binding="{Binding HasData}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter TargetName="HexLine" Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <!-- ===== 컴포저 ===== -->
                            <Border Grid.Row="2" Background="{DynamicResource SubtleBackgroundBrush}"
                                    BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardBorderBrush}"
                                    Padding="12,10">
                                <StackPanel>
                                    <!-- 탭 + 인코딩 -->
                                    <Grid Margin="0,0,0,8">
                                        <Border Style="{StaticResource SegmentTrackStyle}" HorizontalAlignment="Left">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton Content="1회 전송 Once" GroupName="SendMode"
                                                             Style="{StaticResource SegmentToggleStyle}" IsChecked="{Binding IsOnceMode}"/>
                                                <RadioButton Content="주기 전송 Periodic" GroupName="SendMode"
                                                             Style="{StaticResource SegmentToggleStyle}" IsChecked="{Binding IsPeriodicMode}"/>
                                            </StackPanel>
                                        </Border>

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="Encoding" VerticalAlignment="Center" Style="{StaticResource CaptionTextStyle}"/>
                                            <ComboBox Width="100" Margin="8,0,0,0"
                                                      ItemContainerStyle="{StaticResource FluentComboBoxItemStyle}"
                                                      SelectedValue="{Binding SelectedConnection.EncodingName, Mode=TwoWay}"
                                                      SelectedValuePath="Content">
                                                <ComboBox.Style>
                                                    <Style TargetType="ComboBox" BasedOn="{StaticResource FluentComboBoxStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedConnection}" Value="{x:Null}">
                                                                <Setter Property="IsEnabled" Value="False"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding SelectedConnection.Status}" Value="Listening">
                                                                <Setter Property="IsEnabled" Value="False"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding SelectedConnection.Status}" Value="Connected">
                                                                <Setter Property="IsEnabled" Value="False"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ComboBox.Style>
                                                <ComboBoxItem Content="ASCII"/>
                                                <ComboBoxItem Content="UTF-8"/>
                                                <ComboBoxItem Content="EUC-KR"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>

                                    <!-- 입력 + 동작 -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <!-- 1회 전송 입력 -->
                                            <TextBox x:Name="SendTextBox" Height="56"
                                                     Style="{StaticResource MonoMultilineTextBoxStyle}"
                                                     Text="{Binding SendText, UpdateSourceTrigger=PropertyChanged}"
                                                     Visibility="{Binding IsOnceMode, Converter={StaticResource BoolToVis}}"/>

                                            <!-- 주기 전송 입력 -->
                                            <StackPanel Visibility="{Binding IsPeriodicMode, Converter={StaticResource BoolToVis}}">
                                                <TextBox x:Name="PeriodicSendTextBox" Height="56"
                                                         Style="{StaticResource MonoMultilineTextBoxStyle}"
                                                         Text="{Binding PeriodicSendText, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>

                                            <!-- 제어문자 칩 -->
                                            <Grid Margin="0,6,0,0">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                                    <TextBlock Text="제어문자 삽입:" VerticalAlignment="Center"
                                                               Style="{StaticResource CaptionTextStyle}" Margin="0,0,8,0"/>
                                                    <ItemsControl ItemsSource="{Binding ControlCharacters}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Content="{Binding ShortName}" ToolTip="{Binding Name}" Margin="0,0,5,0"
                                                                        Style="{StaticResource ChipButtonStyle}"
                                                                        Command="{Binding DataContext.InsertControlCharacterCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding Tag}"/>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>

                                                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                                                           FontFamily="{StaticResource MonoFontFamily}" FontSize="11"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           Visibility="{Binding IsOnceMode, Converter={StaticResource BoolToVis}}">
                                                    <Run Text="{Binding SendTextByteCount, Mode=OneWay}"/><Run Text=" bytes · "/><Run Text="{Binding SelectedConnection.EncodingName, Mode=OneWay, FallbackValue=ASCII}"/>
                                                </TextBlock>
                                                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                                                           FontFamily="{StaticResource MonoFontFamily}" FontSize="11"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           Visibility="{Binding IsPeriodicMode, Converter={StaticResource BoolToVis}}">
                                                    <Run Text="{Binding PeriodicSendTextByteCount, Mode=OneWay}"/><Run Text=" bytes · "/><Run Text="{Binding SelectedConnection.EncodingName, Mode=OneWay, FallbackValue=ASCII}"/>
                                                </TextBlock>
                                            </Grid>
                                        </StackPanel>

                                        <!-- 우측 버튼 열 -->
                                        <StackPanel Grid.Column="1" Width="150" Margin="10,0,0,0" VerticalAlignment="Top">
                                            <Button Content="Send Once ▶" Command="{Binding SendCommand}"
                                                    Style="{StaticResource AccentButtonStyle}" Height="32"
                                                    Visibility="{Binding IsOnceMode, Converter={StaticResource BoolToVis}}"/>

                                            <StackPanel Visibility="{Binding IsPeriodicMode, Converter={StaticResource BoolToVis}}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox Grid.Column="0" Height="32"
                                                             Style="{StaticResource FluentTextBoxStyle}"
                                                             Text="{Binding IntervalText, UpdateSourceTrigger=PropertyChanged}"
                                                             ToolTip="전송 간격(ms)"/>
                                                    <TextBlock Grid.Column="1" Text="ms" VerticalAlignment="Center" Margin="6,0,0,0"
                                                               Style="{StaticResource CaptionTextStyle}"/>
                                                </Grid>
                                                <Button Content="Start / Stop" Command="{Binding PeriodicSendCommand}"
                                                        Style="{StaticResource AccentButtonStyle}" Height="32" Margin="0,6,0,0"/>
                                            </StackPanel>

                                            <Button Content="Clear Log" Command="{Binding ClearLogCommand}"
                                                    Style="{StaticResource SecondaryButtonStyle}" Height="28" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ========== 빈 상태 (목업 1e) ========== -->
                <Border Grid.Row="1"
                        Visibility="{Binding Connections.Count, Converter={StaticResource EmptyToVis}}"
                        Style="{StaticResource CardBorderStyle}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
                        <TextBlock Text="연결이 없습니다 — No connections yet"
                                   FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="TCP 서버를 열어 들어오는 데이터를 받거나, 클라이언트로 원격 호스트에 접속하세요."
                                   Margin="0,10,0,0" TextAlignment="Center" TextWrapping="Wrap"
                                   Style="{StaticResource BodyTextStyle}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="Open a listener, or dial out to a host."
                                   Margin="0,3,0,0" TextAlignment="Center"
                                   Style="{StaticResource CaptionTextStyle}" Foreground="{DynamicResource TextMutedBrush}"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
                            <Button Content="서버 추가 Add Server" Command="{Binding AddServerCommand}"
                                    Style="{StaticResource AccentButtonStyle}" Height="34" Padding="16,0"/>
                            <Button Content="클라이언트 추가 Add Client" Command="{Binding AddClientCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" Height="34" Padding="16,0" Margin="8,0,0,0"/>
                            <Button Content="세션 불러오기 Load session…" Command="{Binding LoadSessionCommand}"
                                    Style="{StaticResource SubtleButtonStyle}" Height="34" Padding="12,0" Margin="8,0,0,0"/>
                        </StackPanel>

                        <!-- 최근 세션 -->
                        <StackPanel Margin="0,26,0,0" HorizontalAlignment="Center"
                                    Visibility="{Binding RecentSessionPaths.Count, Converter={StaticResource EmptyToVis}, ConverterParameter=Invert}">
                            <TextBlock Text="최근:" HorizontalAlignment="Center" Style="{StaticResource CaptionTextStyle}"/>
                            <ItemsControl ItemsSource="{Binding RecentSessionPaths}" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.OpenRecentSessionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource SubtleButtonStyle}" Height="26"
                                                HorizontalAlignment="Center" ToolTip="{Binding}"
                                                Foreground="{DynamicResource AccentBrush}"
                                                Content="{Binding Converter={StaticResource FileName}}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
