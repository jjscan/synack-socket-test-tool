<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        라이트 테마 색상 팔레트입니다.
        'SYN-ACK Redesign' 목업 1a의 색을 그대로 옮겼습니다.
        여기 정의된 키는 Dark.xaml에도 같은 이름으로 반드시 존재해야 합니다.
        (스타일 쪽에서 DynamicResource로 참조하므로, 사전을 통째로 바꾸면 테마가 즉시 전환됩니다.)
        주석의 rgba()는 목업 원본 값입니다.
    -->

    <Color x:Key="AccentColor">#FF0F6CBD</Color>
    <Color x:Key="AccentHoverColor">#FF0C5595</Color>
    <Color x:Key="SuccessColor">#FF0F7B0F</Color>
    <Color x:Key="DangerColor">#FFC42B1C</Color>
    <Color x:Key="WarningColor">#FF9D5D00</Color>

    <!-- 강조색 -->
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#1A0F6CBD"/>
    <!-- rgba(15,108,189,.10) -->
    <SolidColorBrush x:Key="AccentBadgeBrush" Color="#1F0F6CBD"/>
    <!-- rgba(15,108,189,.12) -->
    <SolidColorBrush x:Key="AccentRowTintBrush" Color="#0B0F6CBD"/>
    <!-- rgba(15,108,189,.045) -->

    <!-- 상태색 -->
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="SuccessBadgeBrush" Color="#1F0F7B0F"/>
    <SolidColorBrush x:Key="SuccessRowTintBrush" Color="#0B0F7B0F"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="DangerBadgeBrush" Color="#1FC42B1C"/>
    <SolidColorBrush x:Key="DangerBorderBrush" Color="#59C42B1C"/>
    <!-- rgba(196,43,28,.35) -->
    <SolidColorBrush x:Key="DangerTintBrush" Color="#0FC42B1C"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#FF7A4D00"/>
    <SolidColorBrush x:Key="WarningBadgeBrush" Color="#1F9D5D00"/>
    <!-- rgba(157,93,0,.12) -->

    <!-- 표면 -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FFF3F3F3"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="SubtleBackgroundBrush" Color="#FFFBFBFB"/>
    <SolidColorBrush x:Key="ControlFillBrush" Color="#FFF0F0F0"/>
    <SolidColorBrush x:Key="SegmentTrackBrush" Color="#FFF3F3F3"/>

    <!-- 테두리 -->
    <SolidColorBrush x:Key="CardBorderBrush" Color="#0F000000"/>
    <!-- rgba(0,0,0,.06) -->
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#1A000000"/>
    <!-- rgba(0,0,0,.10) -->
    <SolidColorBrush x:Key="ControlBorderBottomBrush" Color="#FF8A8A8A"/>

    <!-- 텍스트 -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FF1B1B1B"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF5D5D5D"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#FF616161"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#FF8A8A8A"/>
    <SolidColorBrush x:Key="TextFaintBrush" Color="#FF9A9A9A"/>
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="StoppedDotBrush" Color="#FF9A9A9A"/>

    <!-- 상호작용 -->
    <SolidColorBrush x:Key="HoverOverlayBrush" Color="#0A000000"/>
    <SolidColorBrush x:Key="PressedOverlayBrush" Color="#14000000"/>

    <!-- 그림자. 목업의 0 1px 2px rgba(0,0,0,.04)에 해당합니다. -->
    <DropShadowEffect x:Key="CardShadow" BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.10" Color="#000000"/>
    <DropShadowEffect x:Key="SelectedCardShadow" BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.20" Color="#0F6CBD"/>

</ResourceDictionary>
